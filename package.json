{
  "name": "sevalla-mcp",
  "packageManager": "pnpm@10.30.3",
  "version": "1.0.0",
  "type": "module",
  "volta": {
    "node": "24.14.0",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test test/**/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' test/**/*.test.ts",
    "check:code": "tsc --noEmit --skipLibCheck && oxlint && oxfmt --check",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.0",
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "hono": "^4.12.25",
    "isolated-vm": "^6.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "isolated-vm"
    ],
    "overrides": {
      "ip-address@<=10.1.0": ">=10.1.1"
    }
  }
}
